# Database
DATABASE_URL=sqlite+aiosqlite:///./medsavings.db

# OCR
OCR_PROVIDER=mock
# OCR_API_KEY=

# LLM (optional)
# GEMINI_API_KEY=

# Search API
# SERP_API_KEY=

# Frontend
FRONTEND_URL=http://localhost:3000

# Cache TTL (seconds)
COMPOSITION_CACHE_TTL=604800
PRICE_CACHE_TTL=86400

# Concurrency
MAX_CONCURRENT_REQUESTS=5
RATE_LIMIT_DELAY=1.0

# File upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
